# Luke's lf settings
# Depends on lf 30.1 (breaks on newer versions)
# Note on Image Previews
# For those wanting image previews, like this system, there are four steps to
# set it up. These are done automatically for LARBS users, but I will state
# them here for others doing it manually.
#
# 1. ueberzug must be installed.
# 2. The scope file (~/.config/lf/scope for me), must have a command similar to
#    mine to generate ueberzug images.
# 3. A `set cleaner` line as below is a cleaner script.
# 4. lf should be started through a wrapper script (~/.local/bin/lfub for me)
#    that creates the environment for ueberzug. This command can be be aliased
#    in your shellrc (`alias lf="lfub") or if set to a binding, should be
#    called directly instead of normal lf.
# Basic vars
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set icons
set period 1
set hiddenfiles ".*:*.aux:*.log:*.bbl:*.bcf:*.blg:*.run.xml:*.dxvk-cache:*.gpg:*.o"
set previewer ctpv
set cleaner ctpvclear
&ctpv -s $id
&ctpvquit $id
set info size
# cmd on-select calcdirsize
# set dircounts

cmd quitclear ${{
	if [ -d "$JPROC_DIR" ]; then
		echo "$PWD" >"$JPROC_LF_DIR"
	fi
	lf -remote "send $id quit"
}}

cmd jproc_fzfvim ${{
	if [ -d "$JPROC_DIR" ]; then
		echo "$JPROC_FZF" >"$JPROC_VIM_PROG"
		echo "$PWD" >"$JPROC_VIM_ARG"
		echo "$JPROC_LFCD" >"$JPROC_CMD_LAST"
		echo "$PWD" >"$JPROC_VIM_FILE_LAST"
		lf -remote "send $id quit"
	fi
}}

cmd jproc_grepvim ${{
	if [ -d "$JPROC_DIR" ]; then
		echo "$JPROC_GREPVIM" >"$JPROC_VIM_PROG"
		echo "$PWD" >"$JPROC_VIM_ARG"
		echo "$JPROC_LFCD" >"$JPROC_CMD_LAST"
		echo "$PWD" >"$JPROC_VIM_FILE_LAST"
		lf -remote "send $id quit"
	fi
}}

# Define a custom file-opening handler using an asynchronous shell block (${{ ... }})
cmd open ${{
	# $f contains the path of the currently hovered file
	case $f in
	# Match by specific source code extensions ---
	*.c|*.h)
		# If the process manager directory exists, hand editing over to Vim/Neovim
		if [ -d "$JPROC_DIR" ]; then
			echo "$JPROC_VIMCD" >"$JPROC_VIM_PROG"  # Write target command sequence to pipe
			echo "$fx" >"$JPROC_VIM_ARG"             # Write selected files ($fx) to argument pipe
			lf -remote "send $id quit"               # Signal this specific lf window to exit immediately
		fi
		;;
	*)
		type=$(file --mime-type "$(readlink -f $f)" -b)
		# Fallback to MIME type checking via the 'file' utility ---
		case "$type" in
		# Excel Spreadsheets
		application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
			setsid -f localc $fx
			;;
		# Documents, PDFs, PostScripts, and raw binary streams
		image/vnd.djvu|application/pdf|application/octet-stream|application/postscript)
			setsid -f zathura $fx
			;;
		# Plain text, JSON, empty inodes, and subtitle files
		text/*|application/json|inode/x-empty|application/x-subrip)
			# Hand over to Vim/Neovim process pipeline
			if [ -d "$JPROC_DIR" ]; then
				echo "$JPROC_VIMCD" >"$JPROC_VIM_PROG"
				echo "$fx" >"$JPROC_VIM_ARG"
				lf -remote "send $id quit"
			fi
			;;
		# GIMP native image projects
		image/x-xcf)
			setsid -f gimp $fx
			;;
		# SVG vector graphics (explicitly targets singular hovered file $f)
		image/svg+xml)
			setsid -f display -- $f
			;;
		# General images
		image/*)
			setsid -f sxiv $fx
			;;
		# Audio files and ASF video wrappers (suppresses the graphical window output)
		audio/*|video/x-ms-asf)
			setsid -f mpv --really-quiet --audio-display=no $f >/dev/null 2>&1
			;;
		# Standard video files
		video/*)
			setsid -f mpv --really-quiet $fx >/dev/null 2>&1
			;;
		# Secondary/redundant document rule matching for PDFs and Epubs
		application/pdf|application/vnd.djvu|application/epub*)
			setsid -f zathura $fx >/dev/null 2>&1
			;;
		# Encrypted files (decrypt and view inside the Vim/Neovim workflow)
		application/pgp-encrypted)
			if [ -d "$JPROC_DIR" ]; then
				echo "$JPROC_VIMCD" >"$JPROC_VIM_PROG"
				echo "$fx" >"$JPROC_VIM_ARG"
				lf -remote "send $id quit"
			fi
			;;
		# LibreOffice Word Processors (.docx / .odt)
		application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.oasis.opendocument.text)
			setsid -f lowriter $fx >/dev/null 2>&1
			;;
		# Secondary LibreOffice Spreadsheet rules (.xlsx, .ods, templates)
		application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/octet-stream|application/vnd.oasis.opendocument.spreadsheet|application/vnd.oasis.opendocument.spreadsheet-template)
			setsid -f localc $fx >/dev/null 2>&1
			;;
		# LibreOffice Presentations (.pptx / .odp)
		application/vnd.openxmlformats-officedocument.presentationml.presentation|application/vnd.oasis.opendocument.presentation-template|application/vnd.oasis.opendocument.presentation|application/vnd.ms-powerpoint)
			setsid -f loimpress $fx >/dev/null 2>&1
			;;
		# LibreOffice Graphics / Vector software (.odg)
		application/vnd.oasis.opendocument.graphics|application/vnd.oasis.opendocument.graphics-template)
			setsid -f lodraw $fx >/dev/null 2>&1
			;;
		# LibreOffice Math formulas
		application/vnd.oasis.opendocument.formula)
			setsid -f lomath $fx >/dev/null 2>&1
			;;
		# LibreOffice Database management (.odb)
		application/vnd.oasis.opendocument.database)
			setsid -f lobase $fx >/dev/null 2>&1
			;;
		# If no MIME types match, iterate over all selections ($fx) and run via default system $OPENER
		*)
			for f in $fx; do
				setsid -f $OPENER $f >/dev/null 2>&1;
			done
			;;
		esac
		;;
    esac
}}

cmd mkdir $mkdir -p "$(echo $* | tr ' ' '\ ')"

cmd extract ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "extract? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && aunpack $fx
}}

cmd delete ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "delete? (Y\N) (~/trash)"
	read ans
	dir=$HOME/trash/$(date '+%d_%m_%y_%T')
	mkdir -p "$HOME"/trash
	mkdir -p "$dir"
	[ "$ans" = 'Y' ] && mv -- $fx "$dir"
}}

cmd moveto ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	clear; echo "Move to where? "
	# dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' ${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs | fzf | sed 's|~|$HOME|')" &&
	dest="$(fh)" &&
	for x in $fx; do
		eval mv -iv \"$x\" \"$dest\"
	done &&
	notify-send "🚚 File(s) moved." "File(s) moved to $dest."
}}

cmd copyto ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	clear; echo "Copy to where? "
	# dest="$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' ${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs | fzf | sed 's|~|$HOME|')" &&
	dest="$(fh)" &&
	for x in $fx; do
		eval cp -ivr \"$x\" \"$dest\"
	done &&
	notify-send "📋 File(s) copied." "File(s) copied to $dest."
}}

cmd convert2mov ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "convert to mov? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && "$TERMINAL" -e 2mov $fx &
}}

cmd upscale4thumbnail ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "upscale? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && "$TERMINAL" -e waifu2xauto-res-multi 4 $fx &
}}

cmd forceupscale ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "force upscale? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && alacritty -e waifu2xauto-res 4 $fx &
}}

cmd opengimp ${{
	gimp $fx &
}}

cmd upvid ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "upscale video(s)? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && setsid -f st -e upvid $fx &
}}

cmd subgen ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "generate subtitle? (Y\N)"
	read ans
	[ "$ans" = 'Y' ] && setsid -f st -e subgen $fx &
}}

cmd setbg "$1"
cmd bulkrename $vidir
# Bindings
map <c-f> jproc_fzfvim
map <c-r> jproc_grepvim
# map <c-f> $lf -remote "send $id select \"$(fzfdef)\""
# map J $lf -remote "send $id cd $(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' ${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs | fzfp)"
# map gh
map q quitclear
map g top
map D delete
map E extract
map C copyto
map M moveto
map <c-n> push :mkdir<space>
map . set hidden!
map <enter> shell
map x $$f
map X !$f
map o &mimeopen $f
# map O $mimeopen --ask $f
map A rename # at the very end
map n push A<c-u> # new rename
map I push A<c-a> # at the very beginning
map i push A<a-b><a-b><a-f> # before extension
map a push A<a-b> # after extension
map B bulkrename
map b $setbg $f
map <c-e> down
map <c-y> up
map W $setsid -f $TERMINAL >/dev/null 2>&1
map Y $printf "%s" "$fx" | xclip -selection clipboard
map m convert2mov
map u upvid
map U upscale4thumbnail
map S subgen
map O opengimp
map v push :!nvim<space>
map c push :mv<space>
map Z $fx
# Source Bookmarks
# source "~/.local/share/alias/aliases"
