#!/bin/bash
set -euo pipefail

PROG=${1:?"Error: Process name argument is required"}
TIME=${2:-5}

RECORD=$(sudo mktemp)

# Ensure cleanup happens even on failure or interruption
cleanup() {
	sudo rm -f "$RECORD"
}
trap cleanup EXIT

# Fetch PID safely without triggering SIGPIPE
PID=$(pgrep "$PROG" | head -n 1)

if [ -z "$PID" ]; then
	echo "Error: Process '$PROG' not found." >&2
	exit 1
fi

sudo perf record -o "$RECORD" -g -p "$PID" -- sleep "$TIME"
sudo perf report -i "$RECORD"
