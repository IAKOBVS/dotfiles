general.ipc_socket = true

[colors.primary]
# Peachpuff Background (Warm, Light)
background = "0xf0e0d0"
# Dark Foreground for main text
foreground = "0x3f362e"

[colors.normal]
# Normal Text Colors - Darker for better contrast

# Black (Used for general text/low-priority items) - Much darker gray/near-black
black = "0x262626"
red = "0xcc0000"     
green = "0x008000"   
yellow = "0x8f5f00"  
blue = "0x0000cd"    
magenta = "0x800080" 
# Cyan (Distinct, darker teal for contrast) - Previously 0x008080
cyan = "0x006666"    
# White (Used for general text/high-priority items) - A dark gray
white = "0x5c5c5c"

[colors.bright]
# Bright Text Colors - Also kept darker for better contrast

# Bright Black (Used for comments/faint text) - A medium-dark gray
black = "0x4d4d4d" 
red = "0xff3333"
green = "0x339933"
yellow = "0xad8700"
blue = "0x3333ff"
magenta = "0xaa00aa"
# Bright Cyan (A slightly brighter, distinct teal) - Previously 0x00aaaa
cyan = "0x008888"
# Bright White (A dark gray, slightly brighter than normal white)
white = "0x7a7a7a"

[cursor.style]
blinking = "Never"

[font]
builtin_box_drawing = true
size = 10.0

[[keyboard.bindings]]
action = "Copy"
key = "Y"
mods = "Control"

[[keyboard.bindings]]
action = "Paste"
key = "P"
mods = "Control"

[[keyboard.bindings]]
action = "ToggleViMode"
key = "Space"
mode = "~Search"
mods = "Control"

[[keyboard.bindings]]
action = "ScrollPageUp"
key = "PageUp"
mods = "Control|Shift"

[[keyboard.bindings]]
action = "ScrollPageDown"
key = "PageDown"
mods = "Control|Shift"

[[keyboard.bindings]]
action = "ScrollLineUp"
key = "K"
mods = "Control|Shift"

[[keyboard.bindings]]
action = "ScrollLineDown"
key = "J"
mods = "Control|Shift"

[mouse]
hide_when_typing = false

[terminal.shell]
program = "/usr/bin/zsh"

[window]
opacity = 0.9
